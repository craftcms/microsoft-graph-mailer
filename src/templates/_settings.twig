    name: 'clientSecret',
    suggestEnvVars: true,
    value: adapter.clientSecret,
    errors: adapter.getErrors('clientSecret')
}) }}

{{ forms.autosuggestField({
    required: true,
    label: "Tenant ID"|t('microsoft-graph-mailer'),
    instructions: "The tenant ID."|t('microsoft-graph-mailer'),
    id: 'tenantId',
    name: 'tenantId',
    suggestEnvVars: true,
    value: adapter.tenantId,
    errors: adapter.getErrors('tenantId')
}) }}

{{ forms.autosuggestField({
    required: false,
    label: "Graph Endpoint"|t('microsoft-graph-mailer'),
    instructions: "The Graph Endpoint host. Defaults to the [global service]({link}) one (without the protocol)."|t('microsoft-graph-mailer', {
